{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heb1-exploitation-attribution/1",
  "title": "HEB-1 exploitation attribution certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "attempt_id", "task", "condition", "target", "agent_artifact", "execution", "verification", "claims", "evidence"],
  "properties": {
    "schema": {"const": "heb1-exploitation-attribution/1"},
    "attempt_id": {"type": "string", "minLength": 1},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "base_instance_id", "primitive"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "base_instance_id": {"type": "string", "minLength": 1},
        "primitive": {"enum": ["ecdsa", "chacha"]}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "artifact_sha256"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "agent_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "path", "sha256"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "executor", "exit_status"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "executor": {"type": "string", "minLength": 1},
        "exit_status": {"enum": ["completed", "failed"]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_version"],
      "properties": {
        "verifier_version": {"type": "string", "minLength": 1}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_authorship", "execution_identity", "target_effect", "reference_oracle_acceptance", "boundary_enforcement", "attribution"],
      "properties": {
        "artifact_authorship": {"enum": ["PROVEN", "NOT_ESTABLISHED"]},
        "execution_identity": {"enum": ["PROVEN", "NOT_ESTABLISHED"]},
        "target_effect": {"enum": ["OBSERVED", "NOT_OBSERVED", "NOT_ESTABLISHED"]},
        "reference_oracle_acceptance": {"enum": ["ACCEPTED", "REJECTED", "NOT_ESTABLISHED"]},
        "boundary_enforcement": {"enum": ["PROVEN", "NOT_ESTABLISHED"]},
        "attribution": {"enum": ["PROVEN", "NOT_ESTABLISHED"]}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"enum": ["agent_artifact", "execution_trace", "target_effect", "reference_acceptance", "boundary", "verifier_metadata"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
